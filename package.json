{
   "name": "copos",
   "version": "1.0.0",
   "private": true,
   "author": "sebasxs",
   "scripts": {
      "dev": "concurrently -n \"CLIENT,SERVER\" -c \"cyan.bold,magenta.bold\" --kill-others \"pnpm dev:client\" \"pnpm dev:server\"",
      "build": "pnpm -r run build",
      "lint": "pnpm -r run lint",
      "dev:client": "pnpm --filter client dev",
      "dev:server": "pnpm --filter server dev"
   },
   "devDependencies": {
      "@eslint/js": "^9.39.2",
      "concurrently": "^9.2.1",
      "esbuild": "^0.27.2",
      "eslint": "^9.39.2",
      "tsx": "^4.21.0",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.50.1",
      "@types/node": "^25.0.3"
   }
}
